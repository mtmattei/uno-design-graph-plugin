{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/design-graph.schema.json",
  "title": "Design Graph",
  "description": "A portable semantic intermediate representation for UI designs and applications.",
  "type": "object",
  "required": [
    "schemaVersion",
    "graphId",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "graphId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "sourceSummary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolved"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "screenshot",
            "figma",
            "xaml",
            "csharp",
            "runtime",
            "html",
            "design-system",
            "user",
            "other"
          ]
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "kind",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "observed",
            "declared",
            "derived",
            "inferred"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "rationale": {
          "type": "string"
        },
        "locator": {
          "type": "object",
          "additionalProperties": true,
          "description": "Source-specific locator such as Figma node id, XAML line, DOM selector, or screenshot region."
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "px",
            "dip",
            "pt",
            "unknown"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "screen",
            "region",
            "component",
            "control",
            "content",
            "asset",
            "token",
            "state"
          ]
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "semanticRole": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "value": {},
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "relation",
        "to",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "relation": {
          "type": "string",
          "enum": [
            "contains",
            "instance-of",
            "variant-of",
            "uses-token",
            "has-state",
            "navigates-to",
            "triggers"
          ]
        },
        "to": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "unresolved": {
      "type": "object",
      "required": [
        "id",
        "question",
        "relatedIds"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "relatedIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "possibleValues": {
          "type": "array",
          "items": {}
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}